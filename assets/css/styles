/* ===== ABOUT ===== */
.about__container {
    row-gap: 2rem;
    text-align: center;
}

.about__img {
    justify-self: center;
    width: 200px;
    height: 200px;
    border-radius: 50%; /* Circle */
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0,0,0,0.15); /* Nice shadow */
    border: 4px solid var(--white-color);
}

.about__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.about__subtitle {
    font-size: var(--h2-font-size);
    color: var(--first-color);
    margin-bottom: 1rem;
    font-weight: 600;
}

.about__profession {
    display: block;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    color: var(--text-color-light);
    font-weight: 500;
}

.about__text {
    margin-bottom: 1.5rem;
    text-align: left; /* Better readability */
    color: var(--text-color);
}

.about__social-icon {
    font-size: 1.8rem;
    margin: 0 0.5rem;
    color: var(--text-color-light);
    transition: .3s;
}

.about__social-icon:hover {
    color: var(--first-color);
    transform: translateY(-3px);
}

/* ===== SKILLS ===== */
.skills__container {
    row-gap: 2rem;
    text-align: center;
}

.skills__subtitle {
    font-size: var(--h2-font-size); /* Same style as sections */
    margin-bottom: 1.5rem;
    color: var(--text-color);
}

.skills__data {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
}

/* Modern Pill Style for Skills */
.skills__name {
    display: inline-block;
    padding: .5rem 1.25rem;
    background-color: var(--white-color);
    border-radius: 2rem; /* Fully rounded */
    box-shadow: 0 4px 10px rgba(0,0,0,0.05); /* Soft shadow */
    font-weight: 600;
    color: var(--text-color);
    transition: .3s;
    cursor: default;
    border: 1px solid transparent;
}

.skills__name:hover {
    background-color: var(--first-color);
    color: var(--white-color);
    transform: translateY(-3px);
    box-shadow: 0 8px 15px rgba(108, 99, 255, 0.2);
}

.skills__img {
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--box-shadow);
}


/* ===== PORTFOLIO ===== */
.portfolio__container {
    justify-items: center;
    row-gap: 2.5rem;
}

/* Card Style for Portfolio */
.portfolio__card {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--box-shadow);
    transition: .4s;
    background-color: var(--container-color);
}

/* Hover Lift Effect */
.portfolio__card:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
}

.portfolio__img {
    width: 100%;
    height: 100%; /* Or fixed height */
    object-fit: cover;
    transition: .4s;
}

.portfolio__card:hover .portfolio__img {
    transform: scale(1.05); /* Slight zoom */
}

.portfolio__link {
    position: absolute;
    bottom: 0;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.9); /* More opaque */
    padding: 1.5rem;
    transition: .3s;
    backdrop-filter: blur(5px);
}

.portfolio__link-name {
    display: block;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--first-color);
    margin-bottom: 0.25rem;
}

/* ===== CONTACT ===== */
.contact__container {
    row-gap: 3rem;
    background-color: var(--white-color);
    padding: 3rem 2rem;
    border-radius: 1rem;
    box-shadow: var(--box-shadow);
}

.contact__subtitle {
    font-size: 1rem;
    color: var(--first-color);
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.contact__text {
    display: block;
    margin-bottom: 1.5rem;
    color: var(--text-color);
    font-weight: 500;
}

.contact__inputs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 1rem;
}

.contact__input {
    width: 100%;
    padding: 1rem;
    outline: none;
    border: 2px solid #EEE;
    font-size: var(--normal-font-size);
    margin-bottom: 1.5rem;
    border-radius: .5rem;
    background-color: #FAFAFA;
    transition: .3s;
}

.contact__input:focus {
    border-color: var(--first-color);
    background-color: #FFF;
}

.contact__button {
    display: block;
    background-color: var(--first-color);
    color: var(--white-color);
    padding: 1rem 3rem;
    margin-left: auto;
    border-radius: 2rem;
    border: none;
    outline: none;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: .3s;
    box-shadow: 0 5px 15px rgba(108, 99, 255, 0.2);
}

.contact__button:hover {
    background-color: var(--first-color-alt);
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(108, 99, 255, 0.3);
}

/* ===== FOOTER ===== */
.footer {
    background-color: var(--first-color);
    color: #FFF;
    text-align: center;
    padding: 2rem 0;
}

.footer__title {
    font-size: 1.5rem;
    margin-bottom: var(--mb-2);
    font-weight: 600;
    color: #FFF;
}
.footer__text{
     color: #EEE;
     margin-bottom: 1rem;
}

.footer__link {
    color: #EEE;
    margin: 0 1rem;
    transition: .3s;
}
.footer__link:hover{
    color: #FFF;
    text-decoration: underline;
}

.footer__social{
    color: #FFF;
    font-size: 1.5rem;
    margin: 0 0.5rem;
}


/* ===== MEDIA QUERIES ===== */
@media screen and (min-width: 768px) {
    body {
        margin: 0;
    }

    .section {
        padding-top: 6rem;
        padding-bottom: 4rem;
    }

    .nav {
        height: calc(var(--header-height) + 1.5rem);
    }
    .nav__list {
        display: flex;
    }
    .nav__item {
        margin-left: 2.5rem;
        margin-bottom: 0;
    }
    .nav__toggle {
        display: none;
    }
    
    .home__container {
        height: 100vh;
        grid-template-columns: repeat(2, 1fr); /* 2 Columns */
        align-items: center;
        text-align: initial;
    }
    
    .about__container {
        grid-template-columns: repeat(2, 1fr);
        align-items: center;
        text-align: initial;
        column-gap: 4rem;
    }
    .about__img {
        width: 300px;
        height: 300px;
    }
    
    .skills__container {
        grid-template-columns: repeat(2, 1fr);
        align-items: center;
        column-gap: 3rem;
        text-align: left;
    }
    .skills__data {
        justify-content: flex-start; /* Left align on desktop */
    }
    
    .portfolio__container {
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: auto;
        column-gap: 2rem;
    }
    
    .contact__container {
        grid-template-columns: repeat(2, 1fr);
        justify-items: center;
        width: 80%;
        margin: auto; /* Center the box */
    }
    .contact__form {
        width: 100%;
    }
    
    .footer__container{
         grid-template-columns: repeat(3,1fr);
    }
}

@media screen and (min-width: 1024px) {
    .bd-grid {
        margin-left: auto;
        margin-right: auto;
    }
}
