/*===== GOOGLE FONTS =====*/
@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap");

/*===== VARIABLES CSS =====*/
:root {
    --header-height: 3.5rem; /* Slightly taller header */
    --font-medium: 500;
}

/*===== Colors =====*/
:root {
    /* Premium Palette */
    --first-color: #6C63FF; /* Vibrant Purple/Indigo */
    --first-color-second: #4070F4; /* Blue accent */
    --first-color-alt: #5a52d5;
    --text-color: #3f4448; /* Dark Grey for text */
    --text-color-light: #707070;
    --white-color: #FFFFFF;
    --body-color: #F8F9FD; /* Very subtle cool grey bg */
    --container-color: #FFFFFF;
    --box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08); /* Soft shadow */
}

/*===== Font and Typography =====*/
:root {
    --body-font: 'Poppins', sans-serif;
    --big-font-size: 3.25rem;
    --h1-font-size: 2.25rem;
    --h2-font-size: 1.5rem;
    --normal-font-size: .938rem;
    --small-font-size: .813rem;
}

@media screen and (min-width: 768px) {
    :root {
        --big-font-size: 5rem;
        --h1-font-size: 3rem;
        --h2-font-size: 2rem;
        --normal-font-size: 1rem;
    }
}

/*===== Base =====*/
*, ::before, ::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: var(--header-height) 0 0 0;
    font-family: var(--body-font);
    font-size: var(--normal-font-size);
    color: var(--text-color);
    background-color: var(--body-color);
    line-height: 1.6;
}

h1, h2, h3, p, ul {
    margin: 0;
}

ul {
    padding: 0;
    list-style: none;
}

a {
    text-decoration: none;
    color: var(--text-color);
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

/*===== CSS Classes =====*/
.section {
    padding: 4rem 0 2rem;
}

.section-title {
    position: relative;
    font-size: var(--h2-font-size);
    color: var(--first-color);
    margin-bottom: 2.5rem;
    text-align: center;
    font-weight: 700;
}

.section-title::after {
    position: absolute;
    content: '';
    width: 50px;
    height: 4px; /* Thicker underline */
    left: 0;
    right: 0;
    margin: auto;
    top: 3rem;
    background-color: var(--first-color);
    border-radius: 2px;
}

/*===== Layout =====*/
.bd-grid {
    max-width: 1024px;
    display: grid;
    grid-template-columns: 100%;
    grid-column-gap: 2rem;
    width: calc(100% - 3rem);
    margin-left: 1.5rem;
    margin-right: 1.5rem;
}

.l-header {
    width: 100%;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.85); /* Glass effect */
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05); /* Very subtle shadow */
}

/*===== NAV =====*/
.nav {
    height: var(--header-height);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

@media screen and (max-width: 768px) {
    .nav__menu {
        position: fixed;
        top: var(--header-height);
        right: -100%;
        width: 80%;
        height: 100%;
        padding: 2rem;
        background-color: rgba(255, 255, 255, 0.95); /* Opaque on mobile */
        transition: .4s;
        box-shadow: -2px 0 10px rgba(0,0,0,0.1);
    }
}

.nav__item {
    margin-bottom: 2rem;
}

.nav__link {
    position: relative;
    font-weight: 600;
    color: var(--text-color);
    transition: .3s;
}

.nav__link:hover {
    color: var(--first-color);
}

.nav__logo {
    color: var(--first-color);
    font-weight: 700;
    font-size: 1.25rem;
}

.nav__toggle {
    color: var(--first-color);
    font-size: 1.8rem;
    cursor: pointer;
}

/*=== Show menu ===*/
.show {
    right: 0;
}

/*Active menu*/
.active {
    color: var(--first-color);
}

.active::after {
    position: absolute;
    content: '';
    width: 100%;
    height: 3px;
    left: 0;
    bottom: -6px;
    background-color: var(--first-color);
    border-radius: 2px;
}

/*===== HOME =====*/
.home {
    background: linear-gradient(120deg, var(--white-color) 0%, #f0f2ff 100%);
    overflow: hidden;
}

.home__container {
    height: calc(100vh - var(--header-height));
    row-gap: 2rem;
    align-content: center; /* Vertically center */
}

.home__data {
   align-self: center;
}

.home__title {
    font-size: var(--big-font-size);
    margin-bottom: 1rem;
    line-height: 1.1;
    color: var(--text-color);
}

.home__title span {
    color: var(--first-color);
}

.home__subtitle {
    font-size: 1.2rem;
    color: var(--text-color-light);
    margin-bottom: 2.5rem;
    display: block;
}

.home__button {
    display: inline-block;
    background-color: var(--first-color);
    color: #fff;
    padding: 1rem 2rem;
    border-radius: 2rem;
    font-weight: 600;
    transition: .3s;
    box-shadow: 0 8px 15px rgba(108, 99, 255, 0.25);
}

.home__button:hover {
    background-color: var(--first-color-alt);
    transform: translateY(-3px);
    box-shadow: 0 12px 20px rgba(108, 99, 255, 0.35);
}

.home__blob {
    width: 320px;
    fill: var(--first-color);
    align-self: flex-end; /* Align blob similar to img previously */
}

